[Desktop Entry]
Type=Application
Name=MiniSnap
GenericName=Screenshot Tool
GenericName[vi]=Công cụ chụp màn hình
Comment=Free, open-source screenshot and screen recording software for everyone
Comment[vi]=Phần mềm chụp ảnh, quay phim màn hình miễn phí, mã nguồn mở dành cho mọi người
Exec=minisnap %U
Icon=io.github.kingrubic.MiniSnap
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;screen;capture;record;video;ocr;annotate;snip;chụp;màn hình;quay;
StartupNotify=true
SingleMainWindow=true
Actions=capture-region;capture-full;record;ocr;library;

[Desktop Action capture-region]
Name=Capture region / window
Name[vi]=Chụp vùng / cửa sổ
Exec=minisnap --capture region

[Desktop Action capture-full]
Name=Capture full screen
Name[vi]=Chụp toàn màn hình
Exec=minisnap --capture full

[Desktop Action record]
Name=Record screen video
Name[vi]=Quay video màn hình
Exec=minisnap --record

[Desktop Action ocr]
Name=Capture and extract text (OCR)
Name[vi]=Chụp và trích chữ (OCR)
Exec=minisnap --ocr

[Desktop Action library]
Name=Image & video library
Name[vi]=Thư viện ảnh & video
Exec=minisnap --library
